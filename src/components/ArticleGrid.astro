---
import ArticleCard from './ArticleCard.astro';
import type { ArticleItem } from '../data/impermeabilizantearticles';

export interface Props {
  title?: string;
  subtitle?: string;
  articles: ArticleItem[];
  showDemoNotice?: boolean;
}

const {
  title = 'Artigos e Guias sobre Impermeabilização',
  subtitle = 'Comparações técnicas, diagnósticos e orientações práticas para combater umidade e infiltrações.',
  articles,
  showDemoNotice = true,
} = Astro.props;
---

<section class="article-grid-section" aria-labelledby="articles-section-heading">
  <div class="container">
    <div class="article-grid-section__header">
      <div>
        <h2 id="articles-section-heading" class="article-grid-section__title">
          {title}
        </h2>
        {subtitle && (
          <p class="article-grid-section__subtitle">{subtitle}</p>
        )}
      </div>

      {showDemoNotice && (
        <span class="article-grid-section__badge">
          Estrutura editorial demonstrativa
        </span>
      )}
    </div>

    <div class="article-grid">
      {articles.map((article) => (
        <ArticleCard
          title={article.title}
          description={article.description}
          category={article.category}
          image={article.image}
          imageAlt={article.imageAlt}
          url={article.url}
          date={article.date}
          isDemo={article.isDemo}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .article-grid-section {
    padding: 4rem 0 4.5rem;
    background-color: var(--color-tertiary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .article-grid-section__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2.25rem;
  }

  .article-grid-section__title {
    margin-bottom: 0.35rem;
  }

  .article-grid-section__subtitle {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    margin: 0;
  }

  .article-grid-section__badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  /* 1 coluna no celular, 2 colunas em telas intermediárias, 3 colunas em telas grandes */
  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .article-grid-section__header {
      flex-direction: row;
      align-items: flex-end;
    }

    .article-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }
</style>
