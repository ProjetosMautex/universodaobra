---
import { SITE_CONFIG } from '../config/site';
import MobileMenu from './MobileMenu';

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand-logo" aria-label="Universo da Obra — Página inicial">
      <svg
        class="brand-logo__symbol"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 64 64"
        width="42"
        height="42"
        fill="none"
        aria-hidden="true"
      >
        <rect width="64" height="64" rx="14" fill="#173B46" />
        <path
          d="M18 33V48C18 49.1046 18.8954 50 20 50H44C45.1046 50 46 49.1046 46 48V33"
          stroke="#F5F3EE"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M27 50V37C27 35.8954 27.8954 35 29 35H35C36.1046 35 37 35.8954 37 37V50"
          stroke="#F5F3EE"
          stroke-width="3.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M11 33L32 14L53 33"
          stroke="#E88735"
          stroke-width="5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="32" cy="24" r="2.5" fill="#E88735" />
      </svg>
      <div class="brand-logo__text-group">
        <span class="brand-logo__name">{SITE_CONFIG.name}</span>
        <span class="brand-logo__subtitle">Especialista em Impermeabilização</span>
      </div>
    </a>

    <div class="header-actions">
      <!-- Navegação Desktop -->
      <nav class="desktop-nav" aria-label="Navegação principal">
        <ul class="desktop-nav__list">
          {SITE_CONFIG.navLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['desktop-nav__link', { 'is-active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Navegação Mobile -->
      <div class="mobile-nav-container">
        <MobileMenu client:load links={SITE_CONFIG.navLinks} currentPath={currentPath} />
      </div>

      <!-- Botão de Lupa + Retângulo de Busca -->
      <div class="header-search" id="header-search-container">
        <button
          type="button"
          id="header-search-toggle"
          class="header-search__trigger"
          aria-expanded="false"
          aria-controls="header-search-box"
          aria-label="Abrir busca de artigos"
          title="Pesquisar no portal"
        >
          <svg
            class="header-search__icon-lens"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </button>

        <div
          id="header-search-box"
          class="header-search__dropdown"
          role="dialog"
          aria-label="Caixa de pesquisa"
          hidden
        >
          <form action="/search/" method="get" class="header-search__form" role="search">
            <input
              type="search"
              id="header-search-input"
              name="q"
              class="header-search__input"
              placeholder="O que você procura? Ex: impermeabilizante..."
              aria-label="Digite o que deseja pesquisar"
              autocomplete="off"
              required
            />
            <button type="submit" class="header-search__submit">
              Buscar
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const setupHeaderSearch = () => {
    const container = document.getElementById('header-search-container');
    const toggleBtn = document.getElementById('header-search-toggle');
    const dropdown = document.getElementById('header-search-box');
    const input = document.getElementById('header-search-input') as HTMLInputElement | null;

    if (!container || !toggleBtn || !dropdown || !input) return;

    const openSearch = () => {
      dropdown.hidden = false;
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Fechar busca de artigos');
      setTimeout(() => input.focus(), 30);
    };

    const closeSearch = () => {
      dropdown.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Abrir busca de artigos');
    };

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeSearch();
      } else {
        openSearch();
      }
    });

    document.addEventListener('mousedown', (e) => {
      if (!dropdown.hidden && !container.contains(e.target as Node)) {
        closeSearch();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dropdown.hidden) {
        closeSearch();
        toggleBtn.focus();
      }
    });
  };

  setupHeaderSearch();
  document.addEventListener('astro:page-load', setupHeaderSearch);
</script>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    min-height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-height);
    position: relative;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-primary);
    padding: 0.25rem 0;
  }

  .brand-logo:hover {
    color: var(--color-primary);
  }

  .brand-logo__symbol {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .brand-logo__text-group {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-logo__name {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
  }

  .brand-logo__subtitle {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
  }

  .desktop-nav__list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
  }

  .desktop-nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    font-size: 0.96875rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    position: relative;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .desktop-nav__link:hover {
    color: var(--color-primary);
    background-color: var(--color-tertiary);
  }

  .desktop-nav__link.is-active {
    color: var(--color-primary);
    font-weight: 700;
    background-color: var(--color-tertiary);
  }

  .desktop-nav__link.is-active::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 1rem;
    right: 1rem;
    height: 2.5px;
    background-color: var(--color-secondary);
    border-radius: 2px;
  }

  /* Mobile Menu Styles */
  .mobile-nav-container {
    display: block;
  }

  .mobile-menu-wrapper {
    display: flex;
    align-items: center;
  }

  .mobile-menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    min-height: 44px;
    background-color: var(--color-tertiary);
    color: var(--color-primary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .mobile-menu-trigger:hover,
  .mobile-menu-trigger[aria-expanded='true'] {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }

  .mobile-menu-panel {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    background-color: var(--color-white);
    border-bottom: 2px solid var(--color-primary);
    box-shadow: var(--shadow-md);
    padding: 0.75rem 1.25rem 1.25rem;
    z-index: 110;
  }

  .mobile-menu-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mobile-menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    min-height: 48px;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .mobile-menu-link:hover,
  .mobile-menu-link.is-active {
    background-color: var(--color-tertiary);
    color: var(--color-primary);
    border-color: var(--color-border);
    font-weight: 700;
  }

  .mobile-menu-arrow {
    color: var(--color-secondary);
    font-weight: 700;
  }

  /* Agrupamento Direito do Header (Links + Menu Mobile + Lupa) */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* Lupa e Retângulo de Pesquisa no Header */
  .header-search {
    position: static;
  }

  @media (min-width: 768px) {
    .header-search {
      position: relative;
    }
  }

  .header-search__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--color-tertiary);
    color: var(--color-primary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .header-search__trigger:hover,
  .header-search__trigger[aria-expanded='true'] {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }

  .header-search__dropdown {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    background-color: var(--color-white);
    border: 2px solid var(--color-primary);
    border-top-width: 1px;
    box-shadow: var(--shadow-lg);
    padding: 0.9rem 1.25rem;
    z-index: 120;
  }

  .header-search__dropdown[hidden] {
    display: none !important;
  }

  @media (min-width: 768px) {
    .header-search__dropdown {
      top: calc(100% + 0.65rem);
      left: auto;
      right: 0;
      width: 420px;
      border-top-width: 2px;
      border-radius: var(--radius-md);
      padding: 0.85rem;
    }
  }

  .header-search__form {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }

  .header-search__input {
    flex: 1;
    min-width: 0;
    padding: 0.65rem 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-text);
    background-color: var(--color-bg-alt);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .header-search__input:focus {
    outline: none;
    background-color: var(--color-white);
    border-color: var(--color-secondary);
    box-shadow: 0 0 0 3px rgba(232, 135, 53, 0.2);
  }

  .header-search__submit {
    padding: 0.65rem 1.15rem;
    background-color: var(--color-secondary);
    color: #112228;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 800;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .header-search__submit:hover {
    background-color: var(--color-secondary-hover);
    color: var(--color-white);
  }

  @media (min-width: 768px) {
    .brand-logo__symbol {
      width: 44px;
      height: 44px;
    }

    .brand-logo__name {
      font-size: 1.325rem;
    }

    .desktop-nav {
      display: block;
    }

    .mobile-nav-container {
      display: none;
    }
  }
</style>
