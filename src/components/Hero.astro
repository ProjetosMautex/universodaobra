---
interface Props {
  title?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  title = 'Guia definitivo de impermeabilização para proteger sua construção.',
  subtitle = 'No Universo da Obra, você encontra comparativos técnicos, análises de produtos e orientações práticas para escolher o impermeabilizante certo e acabar com umidade, infiltração e mofo.',
  primaryCtaText = 'Explorar o blog',
  primaryCtaHref = '/blog/',
  secondaryCtaText = 'Conheça o projeto',
  secondaryCtaHref = '/sobre/',
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__grid">
    <div class="hero__content">
      <span class="hero__badge">Especialista em Impermeabilizantes</span>
      <h1 id="hero-heading" class="hero__title">
        {title}
      </h1>
      <p class="hero__subtitle">
        {subtitle}
      </p>
      <div class="hero__actions">
        <a href={primaryCtaHref} class="btn btn-primary">
          <span>{primaryCtaText}</span>
          <span aria-hidden="true">→</span>
        </a>
        {secondaryCtaText && secondaryCtaHref && (
          <a href={secondaryCtaHref} class="btn btn-outline-light">
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <svg
        class="hero__illustration"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 540 400"
        width="540"
        height="400"
        fill="none"
      >
        <!-- Moldura de planta baixa técnica -->
        <rect x="20" y="20" width="500" height="360" rx="16" fill="#0F2931" stroke="#235362" stroke-width="2" />
        <!-- Grade sutil de engenharia -->
        <line x1="20" y1="110" x2="520" y2="110" stroke="#235362" stroke-width="1" stroke-dasharray="6 6" />
        <line x1="20" y1="200" x2="520" y2="200" stroke="#235362" stroke-width="1" stroke-dasharray="6 6" />
        <line x1="20" y1="290" x2="520" y2="290" stroke="#235362" stroke-width="1" stroke-dasharray="6 6" />
        <line x1="145" y1="20" x2="145" y2="380" stroke="#235362" stroke-width="1" stroke-dasharray="6 6" />
        <line x1="270" y1="20" x2="270" y2="380" stroke="#235362" stroke-width="1" stroke-dasharray="6 6" />
        <line x1="395" y1="20" x2="395" y2="380" stroke="#235362" stroke-width="1" stroke-dasharray="6 6" />

        <!-- Estrutura residencial principal -->
        <path d="M105 215L270 85L435 215" stroke="#E88735" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="145" y="205" width="250" height="125" rx="6" fill="#173B46" stroke="#F5F3EE" stroke-width="3.5" />

        <!-- Divisões internas da casa / reforma -->
        <line x1="270" y1="205" x2="270" y2="330" stroke="#F5F3EE" stroke-width="3" />
        <rect x="175" y="235" width="65" height="50" rx="4" fill="#235362" stroke="#E88735" stroke-width="2.5" />
        <rect x="305" y="235" width="60" height="95" rx="4" fill="#235362" stroke="#F5F3EE" stroke-width="2.5" />

        <!-- Cartão de especificação técnica / Nível -->
        <rect x="55" y="55" width="145" height="64" rx="8" fill="#173B46" stroke="#E88735" stroke-width="2" />
        <circle cx="82" cy="87" r="12" fill="#E88735" />
        <line x1="104" y1="80" x2="178" y2="80" stroke="#F5F3EE" stroke-width="4" stroke-linecap="round" />
        <line x1="104" y1="95" x2="156" y2="95" stroke="#647078" stroke-width="3" stroke-linecap="round" />

        <!-- Cartão de medição / Esquadro inferior direito -->
        <rect x="345" y="285" width="140" height="65" rx="8" fill="#F5F3EE" />
        <rect x="362" y="303" width="28" height="28" rx="6" fill="#173B46" />
        <line x1="402" y1="311" x2="465" y2="311" stroke="#173B46" stroke-width="4" stroke-linecap="round" />
        <line x1="402" y1="325" x2="445" y2="325" stroke="#E88735" stroke-width="4" stroke-linecap="round" />

        <!-- Linha de cota da base -->
        <line x1="145" y1="352" x2="395" y2="352" stroke="#E88735" stroke-width="2" />
        <line x1="145" y1="346" x2="145" y2="358" stroke="#E88735" stroke-width="2" />
        <line x1="395" y1="346" x2="395" y2="358" stroke="#E88735" stroke-width="2" />
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding: 3.5rem 0 4rem;
    border-bottom: 4px solid var(--color-secondary);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero__badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    background-color: rgba(232, 135, 53, 0.14);
    border: 1px solid rgba(232, 135, 53, 0.35);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.15rem;
  }

  .hero__title {
    color: var(--color-white);
    margin-bottom: 1.15rem;
    max-width: 22ch;
  }

  .hero__subtitle {
    color: rgba(245, 243, 238, 0.92);
    font-size: clamp(1.05rem, 1.2vw + 0.5rem, 1.2rem);
    line-height: 1.65;
    max-width: 56ch;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__illustration {
    width: 100%;
    max-width: 520px;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 992px) {
    .hero {
      padding: 4.75rem 0 5.25rem;
    }

    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }
  }
</style>
