---
export interface Props {
  title: string;
  description: string;
  category?: string;
  image: string;
  imageAlt: string;
  url?: string;
  date?: string;
  isDemo?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  url,
  date,
  isDemo = false,
} = Astro.props;

const hasRealUrl = Boolean(url && !isDemo);
---

<article class="article-card">
  <div class="article-card__media">
    <img
      src={image}
      alt={imageAlt}
      width="600"
      height="375"
      loading="lazy"
      decoding="async"
      class="article-card__img"
    />
  </div>

  <div class="article-card__body">
    {date && (
      <time class="article-card__date">{date}</time>
    )}

    <h3 class="article-card__title">
      {hasRealUrl ? (
        <a href={url} class="article-card__title-link">
          {title}
        </a>
      ) : (
        <span>{title}</span>
      )}
    </h3>

    <p class="article-card__description">
      {description}
    </p>

    <div class="article-card__footer">
      {hasRealUrl ? (
        <a href={url} class="article-card__cta">
          <span>Ler guia completo</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span
          class="article-card__cta article-card__cta--preview"
          aria-disabled="true"
          title="Conteúdo demonstrativo da estrutura editorial — artigo em preparação"
        >
          <span>Conteúdo em preparação</span>
          <span class="article-card__demo-tag">Prévia de layout</span>
        </span>
      )}
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    height: 100%;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(23, 59, 70, 0.28);
  }

  .article-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background-color: var(--color-tertiary);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .article-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.35rem 1.35rem 1.25rem;
  }

  .article-card__date {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.4rem;
  }

  .article-card__title {
    font-size: 1.15rem;
    line-height: 1.35;
    color: var(--color-primary);
    margin-bottom: 0.65rem;
  }

  .article-card__title-link {
    color: inherit;
    text-decoration: none;
  }

  .article-card__title-link:hover {
    color: var(--color-secondary-hover);
    text-decoration: underline;
  }

  .article-card__description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .article-card__footer {
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .article-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .article-card__cta:hover {
    color: var(--color-secondary-hover);
  }

  .article-card__cta--preview {
    color: var(--color-text-muted);
    cursor: default;
  }

  .article-card__cta--preview:hover {
    color: var(--color-text-muted);
  }

  .article-card__demo-tag {
    font-size: 0.75rem;
    font-weight: 600;
    background-color: var(--color-tertiary);
    color: var(--color-primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }
</style>
