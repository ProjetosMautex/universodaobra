---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles } from '../../data/impermeabilizantearticles';
---

<BaseLayout
  title="Blog"
  description="Guias, comparativos e conteúdos informativos sobre materiais de construção, ferramentas, impermeabilização, manutenção residencial e reforma."
>
  <section class="page-header">
    <div class="container">
      <span class="page-header__eyebrow">Conteúdo Editorial</span>
      <h1 class="page-header__title">Blog</h1>
      <p class="page-header__lead">
        Acompanhe nossos guias, comparativos e orientações práticas sobre materiais, ferramentas,
        manutenção residencial e etapas de reforma.
      </p>
    </div>
  </section>

  <section class="blog-section">
    <div class="container">
      <!-- Grade de artigos ou Estado Vazio -->
      {articles.length > 0 ? (
        <div class="blog-grid">
          {articles.map((article) => (
            <ArticleCard
              title={article.title}
              description={article.description}
              category={article.category}
              image={article.image}
              imageAlt={article.imageAlt}
              url={article.url}
              date={article.date}
              isDemo={article.isDemo}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <div class="empty-state__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 64 64"
              width="56"
              height="56"
              fill="none"
            >
              <rect width="64" height="64" rx="14" fill="#173B46" />
              <path
                d="M18 33V48C18 49.1046 18.8954 50 20 50H44C45.1046 50 46 49.1046 46 48V33"
                stroke="#F5F3EE"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M11 33L32 14L53 33"
                stroke="#E88735"
                stroke-width="5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <h2 class="empty-state__title">Conteúdos em preparação</h2>
          <p class="empty-state__text">
            Estamos preparando nossos primeiros conteúdos. Em breve, você encontrará aqui guias e
            comparativos sobre construção e reforma.
          </p>
          <div class="empty-state__actions">
            <a href="/" class="btn btn-secondary">
              Voltar para a página inicial
            </a>
            <a href="/sobre/" class="btn btn-primary">
              Conhecer a proposta do portal
            </a>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-section {
    padding: 3.5rem 0 4.5rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .empty-state {
    background-color: var(--color-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 3rem 1.5rem;
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
  }

  .empty-state__icon {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .empty-state__title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .empty-state__text {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 52ch;
    margin: 0 auto 1.75rem;
    line-height: 1.7;
  }

  .empty-state__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
</style>
