---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import { articles } from '../data/impermeabilizantearticles';

const featuredArticles = articles.slice(0, 6);
---

<BaseLayout
  title="Universo da Obra — Especialista em Impermeabilizantes e Umidade"
  description="Portal especializado em impermeabilização residencial e predial: comparativos dos melhores impermeabilizantes, guias práticos e soluções contra infiltração e mofo."
>
  <Hero />

  <!-- Seção de apresentação do portal -->
  <section class="intro-section" aria-labelledby="intro-heading">
    <div class="container-narrow intro-section__inner">
      <span class="intro-section__eyebrow">Proposta Editorial</span>
      <h2 id="intro-heading" class="intro-section__title">
        Tudo o que você precisa saber para impermeabilizar com eficácia
      </h2>
      <p class="intro-section__text">
        Seja para eliminar umidade no rodapé, proteger paredes externas contra chuvas fortes ou vedar lajes e telhados, reunimos análises técnicas, comparativos aprofundados e tutoriais passo a passo para você escolher o impermeabilizante certo e blindar sua construção de forma definitiva.
      </p>
    </div>
  </section>

  <!-- Seção com cards dos artigos mais recentes -->
  <ArticleGrid
    title="Artigos e Guias sobre Impermeabilização"
    subtitle="Análises técnicas, testes de produtos e tutoriais práticos para combater infiltrações e umidade."
    articles={featuredArticles}
    showDemoNotice={false}
  />
</BaseLayout>

<style>
  .intro-section {
    padding: 4rem 0;
    background-color: var(--color-white);
  }

  .intro-section__inner {
    text-align: center;
  }

  .intro-section__eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    background-color: var(--color-tertiary);
    padding: 0.25rem 0.7rem;
    border-radius: 4px;
    margin-bottom: 0.9rem;
  }

  .intro-section__title {
    margin-bottom: 1rem;
  }

  .intro-section__text {
    font-size: clamp(1.05rem, 1vw + 0.5rem, 1.1875rem);
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 64ch;
    margin-inline: auto;
  }
</style>
