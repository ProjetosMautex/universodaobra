---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config/site';
---

<BaseLayout
  title="Contato — Universo da Obra"
  description="Entre em contato com o Universo da Obra. Envie suas dúvidas sobre impermeabilizantes, diagnóstico de infiltração, sugestões ou mensagens para nossa equipe."
>
  <section class="page-header">
    <div class="container">
      <span class="page-header__eyebrow">Atendimento e Comunicação</span>
      <h1 class="page-header__title">Fale Conosco</h1>
      <p class="page-header__lead">
        Tem alguma dúvida sobre impermeabilização, sugestão de análise de produto ou quer falar sobre parcerias? Preencha os campos abaixo para falar diretamente com nossos especialistas.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <!-- Coluna 1: Formulário de Mensagem -->
        <div class="contact-card">
          <div class="contact-card__header">
            <div class="contact-card__icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <div>
              <h2 class="contact-card__title">Envie sua mensagem</h2>
              <p class="contact-card__subtitle">
                Preencha os dados abaixo. Ao clicar em enviar, abriremos seu gerenciador de e-mail com a mensagem montada para <strong>{SITE_CONFIG.contactEmail}</strong>.
              </p>
            </div>
          </div>

          <form id="contact-form" class="contact-form" novalidate>
            <!-- Campo Nome -->
            <div class="form-group">
              <label for="contact-name" class="form-label">
                Nome completo <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                class="form-input"
                placeholder="Ex.: Carlos Eduardo Silva"
                required
              />
              <span class="form-error" id="error-name" aria-live="polite"></span>
            </div>

            <!-- Campo E-mail -->
            <div class="form-group">
              <label for="contact-email" class="form-label">
                Seu e-mail de retorno <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                class="form-input"
                placeholder="seuemail@exemplo.com"
                required
              />
              <span class="form-error" id="error-email" aria-live="polite"></span>
            </div>

            <!-- Campo Do que se trata -->
            <div class="form-group">
              <label for="contact-subject" class="form-label">
                Do que se trata (Assunto) <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-subject"
                name="subject"
                class="form-input"
                placeholder="Ex.: Dúvida sobre impermeabilização, sugestão de artigo..."
                required
              />
              <span class="form-error" id="error-subject" aria-live="polite"></span>
            </div>

            <!-- Campo Mensagem -->
            <div class="form-group">
              <label for="contact-message" class="form-label">
                Mensagem <span class="required" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                class="form-textarea"
                rows="5"
                placeholder="Escreva detalhadamente sua dúvida, sugestão ou proposta..."
                required
              ></textarea>
              <span class="form-error" id="error-message" aria-live="polite"></span>
            </div>

            <button type="submit" class="btn btn-secondary contact-form__submit" id="submit-btn">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="22" y1="2" x2="11" y2="13" />
                <polygon points="22 2 15 22 11 13 2 9 22 2" />
              </svg>
              Abrir no seu E-mail para Enviar
            </button>

            <div id="form-feedback" class="form-feedback" role="alert" style="display: none;"></div>
          </form>
        </div>

        <!-- Coluna 2: Informações de Contato (NAP) -->
        <div class="nap-column">
          <div class="nap-card">
            <h2 class="nap-card__title">Informações de Contato</h2>
            <p class="nap-card__desc">
              Dados institucionais e canais oficiais de comunicação do Universo da Obra:
            </p>

            <div class="nap-items">
              <!-- Responsável -->
              <div class="nap-item">
                <div class="nap-item__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                </div>
                <div class="nap-item__content">
                  <span class="nap-item__label">Responsável</span>
                  <strong class="nap-item__value">{SITE_CONFIG.responsible}</strong>
                </div>
              </div>

              <!-- Empresa / Projeto -->
              <div class="nap-item">
                <div class="nap-item__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  </svg>
                </div>
                <div class="nap-item__content">
                  <span class="nap-item__label">Empresa / Projeto</span>
                  <strong class="nap-item__value">{SITE_CONFIG.name}</strong>
                </div>
              </div>

              <!-- E-mail -->
              <div class="nap-item">
                <div class="nap-item__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                </div>
                <div class="nap-item__content">
                  <span class="nap-item__label">E-mail Oficial</span>
                  <a href={`mailto:${SITE_CONFIG.contactEmail}`} class="nap-item__link">
                    {SITE_CONFIG.contactEmail}
                  </a>
                </div>
              </div>

              <!-- Telefone -->
              <div class="nap-item">
                <div class="nap-item__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                </div>
                <div class="nap-item__content">
                  <span class="nap-item__label">Telefone</span>
                  <a href={`tel:+${SITE_CONFIG.contactPhoneRaw}`} class="nap-item__link">
                    {SITE_CONFIG.contactPhone}
                  </a>
                  <span class="nap-item__hint">({SITE_CONFIG.contactHours})</span>
                </div>
              </div>

              <!-- Endereço -->
              <div class="nap-item">
                <div class="nap-item__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                </div>
                <div class="nap-item__content">
                  <span class="nap-item__label">Endereço</span>
                  <address class="nap-item__address">
                    {SITE_CONFIG.address.street}<br />
                    {SITE_CONFIG.address.city} - {SITE_CONFIG.address.state}, CEP {SITE_CONFIG.address.zip}<br />
                    {SITE_CONFIG.address.country}
                  </address>
                </div>
              </div>
            </div>
          </div>

          <!-- Card de temas aceitos -->
          <div class="info-card">
            <h3 class="info-card__title">Atendimento Editorial</h3>
            <ul class="info-card__list">
              <li>Respondemos mensagens normalmente em até 1 dia útil.</li>
              <li>Dúvidas sobre impermeabilizantes, diagnóstico de infiltrações e sugestões de pautas são muito bem-vindas.</li>
              <li>Para assuntos comerciais ou parcerias, identifique sua empresa no formulário.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const setupContactForm = () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;

    if (!form || !feedback) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('contact-name') as HTMLInputElement;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement;
      const subjectInput = document.getElementById('contact-subject') as HTMLInputElement;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const subject = subjectInput.value.trim();
      const message = messageInput.value.trim();

      let hasError = false;

      // Validação simples
      if (!name) {
        document.getElementById('error-name')!.textContent = 'Por favor, informe seu nome.';
        hasError = true;
      } else {
        document.getElementById('error-name')!.textContent = '';
      }

      if (!email || !email.includes('@') || !email.includes('.')) {
        document.getElementById('error-email')!.textContent = 'Informe um e-mail válido.';
        hasError = true;
      } else {
        document.getElementById('error-email')!.textContent = '';
      }

      if (!subject) {
        document.getElementById('error-subject')!.textContent = 'Informe o assunto da mensagem.';
        hasError = true;
      } else {
        document.getElementById('error-subject')!.textContent = '';
      }

      if (!message) {
        document.getElementById('error-message')!.textContent = 'Escreva sua mensagem.';
        hasError = true;
      } else {
        document.getElementById('error-message')!.textContent = '';
      }

      if (hasError) return;

      // Monta corpo do e-mail estruturado
      const emailRecipient = 'contato@universodaobra.com';
      const emailSubject = `[Contato Universo da Obra] ${subject}`;
      const emailBody = [
        `Nome: ${name}`,
        `E-mail para resposta: ${email}`,
        `Assunto: ${subject}`,
        '',
        '--- MENSAGEM ---',
        message,
        '',
        '---',
        'Enviado através do formulário de contato do site Universo da Obra'
      ].join('\r\n');

      const mailtoUrl = `mailto:${encodeURIComponent(emailRecipient)}?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;

      // Exibe mensagem visual amigável
      feedback.style.display = 'block';
      feedback.className = 'form-feedback form-feedback--success';
      feedback.innerHTML = `
        <strong>Abrindo seu gerenciador de e-mail...</strong><br />
        Seu aplicativo de mensagens foi acionado com os dados preenchidos prontos para enviar para <strong>${emailRecipient}</strong>.<br />
        <small>Caso o seu aplicativo não tenha aberto automaticamente, <a href="${mailtoUrl}" class="feedback-link">clique aqui para tentar novamente</a> ou envie diretamente para <strong>${emailRecipient}</strong>.</small>
      `;

      // Aciona o gerenciador de e-mail do usuário
      window.location.href = mailtoUrl;
    });
  };

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>

<style>
  .contact-section {
    padding: 3.5rem 0 5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1.25fr 0.95fr;
      gap: 2.5rem;
      align-items: start;
    }
  }

  /* Card do Formulário */
  .contact-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 640px) {
    .contact-card {
      padding: 2.5rem 2rem;
    }
  }

  .contact-card__header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .contact-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background-color: var(--color-tertiary);
    color: var(--color-primary);
  }

  .contact-card__title {
    font-size: 1.375rem;
    margin-bottom: 0.35rem;
    color: var(--color-primary);
  }

  .contact-card__subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Formulário e Campos "Quadrados" */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .required {
    color: #c53030;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text);
    background-color: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: 6px;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    background-color: var(--color-white);
    box-shadow: 0 0 0 3px rgba(23, 59, 70, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-error {
    font-size: 0.8125rem;
    color: #c53030;
    font-weight: 600;
    min-height: 1rem;
  }

  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.95rem 1.5rem;
    font-size: 1.0625rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 0.5rem;
  }

  .form-feedback {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .form-feedback--success {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
  }

  .feedback-link {
    color: #166534;
    font-weight: 700;
    text-decoration: underline;
  }

  /* Coluna NAP */
  .nap-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .nap-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .nap-card__title {
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .nap-card__desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .nap-items {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .nap-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .nap-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .nap-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background-color: var(--color-tertiary);
    color: var(--color-primary);
  }

  .nap-item__content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .nap-item__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
  }

  .nap-item__value {
    font-size: 1.05rem;
    color: var(--color-primary);
    font-weight: 700;
  }

  .nap-item__link {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    word-break: break-all;
  }

  .nap-item__link:hover {
    color: var(--color-secondary-hover);
  }

  .nap-item__hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .nap-item__address {
    font-style: normal;
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  /* Info Card */
  .info-card {
    background-color: var(--color-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .info-card__title {
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .info-card__list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .info-card__list li {
    margin-bottom: 0.4rem;
    line-height: 1.5;
  }
</style>